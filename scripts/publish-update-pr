#!/usr/bin/env bash
#
# Pushes the branch that scripts/update-gems or scripts/update-packages
# committed, and opens its PR with the lane label (ISS#41).
#
# In CI this runs as its own workflow step after the update step, and the
# mpi-automation App token is minted between the two. The token never shares a
# step, an environment or a git config with the dependency code that `bundle`
# and `yarn` fetch and run. Run locally, the update scripts call it directly.
#
# Usage: publish-update-pr <dir>
#   <dir> holds what the update script wrote: branch, title, body, label
#   (may be empty) and new_branch (true|false). No <dir>/branch means the
#   update script found nothing to commit; this exits 0.
#
# Environment:
#   GH_TOKEN   Token for the push and `gh pr create`. When set, git sends it in
#              a header scoped to https://github.com/ for this push only; it is
#              never written to git config. Unset, git and gh use the
#              developer's own credentials.
#   GIT_USER_NAME, GIT_USER_EMAIL
#              When set, the update commit is re-authored to this identity
#              (the App's bot user in CI).

set -euo pipefail

PR_DIR="${1:?usage: publish-update-pr <dir>}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ ! -f "$PR_DIR/branch" ]; then
  echo -e "${GREEN}✓ Nothing to publish: the update step made no commit.${NC}"
  exit 0
fi

BRANCH_NAME="$(cat "$PR_DIR/branch")"
PR_TITLE="$(cat "$PR_DIR/title")"
PR_BODY="$(cat "$PR_DIR/body")"
LANE_LABEL="$(cat "$PR_DIR/label")"
CREATE_NEW_BRANCH="$(cat "$PR_DIR/new_branch")"

# The update step ran dependency install scripts in this checkout, so its git
# hooks are not trusted: every git call here runs with hooks disabled.
GIT=(git -c core.hooksPath=/dev/null)

if [ -n "${GIT_USER_NAME:-}" ] && [ -n "${GIT_USER_EMAIL:-}" ]; then
  echo -e "${YELLOW}Re-authoring the update commit as ${GIT_USER_NAME}...${NC}"
  "${GIT[@]}" -c user.name="$GIT_USER_NAME" -c user.email="$GIT_USER_EMAIL" \
    commit --amend --no-edit --reset-author --quiet
fi

PUSH=("${GIT[@]}")
if [ -n "${GH_TOKEN:-}" ]; then
  BASIC_AUTH="$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')"
  PUSH+=(-c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${BASIC_AUTH}")
fi

echo -e "${YELLOW}Pushing branch to GitHub...${NC}"
"${PUSH[@]}" push -u origin "$BRANCH_NAME"

if [ "$CREATE_NEW_BRANCH" != "true" ]; then
  echo -e "${GREEN}✓ Changes pushed to existing branch: ${BRANCH_NAME}${NC}"
  echo -e "${YELLOW}The existing PR will be updated automatically.${NC}"
  exit 0
fi

if ! command -v gh &> /dev/null; then
  echo -e "${RED}GitHub CLI (gh) not installed. Please create the PR manually.${NC}"
  echo -e "${YELLOW}Branch pushed: ${BRANCH_NAME}${NC}"
  echo ""
  echo "PR Title: $PR_TITLE"
  echo "PR Label: ${LANE_LABEL:-(none)}"
  echo ""
  echo "PR Body:"
  echo "$PR_BODY"
  exit 0
fi

if ! gh auth status >/dev/null 2>&1 && [ -z "${GH_TOKEN:-${GITHUB_TOKEN:-}}" ]; then
  echo -e "${YELLOW}Skipping PR creation - authenticate gh or export GH_TOKEN.${NC}"
  echo -e "${YELLOW}Branch pushed: ${BRANCH_NAME}${NC}"
  exit 0
fi

echo -e "${YELLOW}Creating pull request...${NC}"
PR_ARGS=()
[ -n "$LANE_LABEL" ] && PR_ARGS=(--label "$LANE_LABEL")
# In CI, name the repo rather than letting gh read it from the checkout's
# git remotes, which the update step could have rewritten.
[ -n "${GITHUB_REPOSITORY:-}" ] && PR_ARGS+=(--repo "$GITHUB_REPOSITORY")
gh pr create \
  --title "$PR_TITLE" \
  --body "$PR_BODY" \
  --base main \
  --head "$BRANCH_NAME" \
  ${PR_ARGS[@]+"${PR_ARGS[@]}"}
echo -e "${GREEN}✓ Pull request created successfully!${NC}"
